:: notebook-header [nobr]
<header>
MY NOTEBOOK
</header>


:: notebook-footer [nobr]
<footer>
<<button "Back">>
    <<goto $prevpass>>
    <</button>>

<div class="command-container">
  <<link "Go to notebook">><<goto "Notebook">><</link>> |
  <<link "Contents page">><<goto "Map">><</link>> |
   <<link "My basket">><<goto "Basket">><</link>>
</div>

<<button "Next">>
    <<goto $nextpass>>
    <</button>>
</footer>

:: Notebook [nobr]
<<set $t to Engine.restart()>>
<<if $world.hasOwnProperty($location)>>
  <<set _room = $world[$location]>>
<<else>>
  <<set _room = {
    name: "Unknown",
    desc: "This place does not exist.",
    exits: {}
  }>>
<</if>>
<<include "notebook-header">>
<main class="notebook">
<h2><<= _room.name>></h2>
<p><<= _room.desc>></p>
<<set _chapterPassage = "chapter-" + $location>> 

<<if Story.has(_chapterPassage)>> <<button "View Notes">> <<goto _chapterPassage>> <</button>> <</if>>

<div>
<h3>Move around in your notebook</h3>
<b>Exits:</b>

<ul class="exits-container">
  <<for _dir, _dest range _room.exits>>
  
    <<set _target = $world[_dest]>>
  
    <<if _target.locked>>
      <<print _dir>> — (locked)<br>
    <<else>>
      <li class="exits-item">
      <<link _dir>>
        <<set $location = _dest>>
        <<goto "Notebook">>
      <</link>>
      </li>
    <</if>>
  
  <</for>>
</ul>

<span>Travel to a different page</span>
<div class="command-input-container">
  
  <form>
    <<textbox "$command" "direction">>
  </form>
  
  <<button "Enter">>
    <<set _cmd = $command.toLowerCase()>>
  
    <<if _cmd is "look">>
      <<goto "Notebook">>
  
    <<elseif _cmd is "north" or _cmd is "n">>
      <<set _dir = "north">>
      <<if $world[$location].exits[_dir]>>
        <<set $location = $world[$location].exits[_dir]>>
      <</if>>
      <<goto "Notebook">>
  
    <<elseif _cmd is "south" or _cmd is "s">>
      <<set _dir = "south">>
      <<if $world[$location].exits[_dir]>>
        <<set $location = $world[$location].exits[_dir]>>
      <</if>>
      <<goto "Notebook">>
  
    <<elseif _cmd is "east" or _cmd is "e">>
      <<set _dir = "east">>
      <<if $world[$location].exits[_dir]>>
        <<set $location = $world[$location].exits[_dir]>>
      <</if>>
      <<goto "Notebook">>
  
    <<elseif _cmd is "west" or _cmd is "w">>
      <<set _dir = "west">>
      <<if $world[$location].exits[_dir]>>
        <<set $location = $world[$location].exits[_dir]>>
      <</if>>
      <<goto "Notebook">>
  
    <<else>>
      You can't do that.
    <</if>>
  <</button>>
</div>
</div>

</main>
<<include "notebook-footer">>



:: Map [nobr]
<main>
    <h3>Where are we?</h3>
    
    You are currently in: <b><<= $location>></b><br><br>
    
    <<for _room, _data range $world>>
      <<if _room is $location>>
        ▶ <<=_data.name>><br>
      <<else>>
        · <<=_data.name>><br>
      <</if>>
    <</for>>
    
    <br>
    <<link "Back">><<goto "Notebook">><</link>>
</main>



:: Basket [nobr]

<<include "notebook-header">>

<main class="basket">

<h2>Your Basket</h2>

<<if $basket.length is 0>>

    <p>Your basket is empty.</p>

<<else>>

    <ul>

    <<for _note range $basket>>

        <li>

            <<= _note>>

            <<link "Remove">>
                <<run $basket.delete($basket.indexOf(_note))>>
                <<goto "Basket">>
            <</link>>

        </li>

    <</for>>

    </ul>

<</if>>

<hr>

<<link "Back to Notebook">>
    <<goto "Notebook">>
<</link>>

</main>





:: chapter-template [nobr]

<<set _chapter = $world[$currentChapter]>>

<main>
<p class="instruction">Ready when you are...</p>
<div id="mount"></div>

<h2><<= _chapter.name>></h2>
<p><<= _chapter.desc>></p>

<hr>

<<set _notes = _chapter.notes>>

<ul class="notes">

<<for _note range _notes>>

    <<capture _note>>

    <li>

        _note
        <<if $basket.includes(_note)>>

            <span class="selected">(In basket)</span>

            <<button "Remove">>
                <<run $basket.delete(_note)>>
                <<goto $pass>>
            <</button>>

        <<else>>

            <<button "Add">>
                <<if !$basket.includes(_note)>>
                    <<run $basket.push(_note)>>
                <</if>>
                <<goto $pass>>
            <</button>>

        <</if>>

    </li>

    <</capture>>

<</for>>

</ul>

<div id="basket-count">
    Items: <<= $basket.length>>
</div>

<<link "View Basket">>
    <<goto "Basket">>
<</link>>

|
<<link "Back to Notebook">>
    <<goto "Notebook">>
<</link>>

</main>


