:: StoryInit {"position":"100,100","size":"100,100"}

<<set $location = "sisters">>

<<set $world = {
  sisters: {
    name: "Silver Sisters",
    desc: "The strangeness of the sisters. Who were they? How can we know them better?",
    exits: {
      north: "truth",
      east: "art",
      south: "fiction"
    }, 
     locked: false
  },

  art: {
    name: "Making Art",
    desc: "Trying to put boundaries on the undefinable and the infinite",
     exits: {
      west: "sisters",
      north: "truth",
      south: "collaboration"
    }, 
     locked: false
  },

  fiction: {
    name: "Fictionalised verisons of ourselves",
    desc: "We don't want to commit to becoming entangled with these people. So its really about a fictionalised version of us",
    exits: {
    west: "power",
    south: "collaboration"
  }, 
   locked: false
  }, 
  power: {
    name: "The Corrupting Influence of Power",
    desc: "Can anything ever be truly equal? How long can idealism last?",
  exits: {
    west: "truth",
    east: "fiction",
    south: "collaboration"
  }, 
   locked: false
  }, 
  collaboration: {
    name: "Collaboration",
    desc: "lorem ipsum",
    exits: {
    north: "power",
    west: "art",
    east: "fiction",
    south: "sisters"
  }, 
   locked: false
  }, 
  truth: {
    name: "Truth",
    desc: "lorem ipsum",
    exits: {
    east: "power",
    south: "sisters",
    west: "art"
  }, 
  locked: true
  }, 
  
}>>


:: header [nobr]
<header>
Head
</header>


:: footer [nobr]
<footer>
<<button "Back">>
    <<goto $prevpass>>
    <</button>>
<<button "Next">>
    <<goto $nextpass>>
    <</button>>
</footer>

:: test-content [nobr]


<<timed 0.1s>>
 <<replace "#mount">>
    <<type 60ms>>
      <p>  Hello</p>
    <</type>>
    <</replace>>
<</timed>>

<<timed 3s>>
 <<append "#mount">>
    <<type 60ms>>
        <p>This is a test</p>
    <</type>>
    <</append>>
<</timed>>

<<timed 6s>>
 <<append "#mount">>
    <<type 60ms>>
        <p>And another one</p>
    <</type>>
    <</append>>
<</timed>>

<<timed 8s>>
 <<append "#mount">>
    <<type 60ms>>
       <p>
         <<button "Next">>
         <<goto $nextpass>>
         <</button>>
       </p>
    <</type>>
    <</append>>
<</timed>>

:: landing [nobr]
<<set $prevpass to "">>
<<set $pass to "landing">>
<<set $nextpass to "option1">>

<<include "header">>
<main>
<p class="instruction">Ready when you are...</p>
<div id="mount"></div>
<<include "test-content">>
</main>
<<include "footer">>


:: option1 [nobr]
<<set $prevpass to "landing">>
<<set $pass to "option1">>
<<set $nextpass to "option2">>
<<addclass "body" "lightblue">>
<<include "header">>
<main>
<p class="instruction">Ready when you are...</p>
<div id="mount"></div>
<<include "test-content">>
</main>
<<include "footer">>

:: option2 [nobr]
<<set $prevpass to "option1">>
<<set $pass to "option2">>
<<set $nextpass to "Room">>
<<addclass "body" "lightblue">>
<<include "header">>
<main>
<p class="satchel-title">You can see: </p>
<div id="mount"></div>
<<include "test-content">>
</main>
<<include "footer">>

:: Room [nobr]
<<if $world.hasOwnProperty($location)>>
  <<set _room = $world[$location]>>
<<else>>
  <<set _room = {
    name: "Unknown",
    desc: "This place does not exist.",
    exits: {}
  }>>
<</if>>

<main>
<h2><<= _room.name>></h2>
<p><<= _room.desc>></p>

<hr>

<b>Exits:</b><br>

<<for _dir, _dest range _room.exits>>

  <<set _target = $world[_dest]>>

  <<if _target.locked>>
    <<print _dir>> — (locked)<br>
  <<else>>
    <<link _dir>>
      <<set $location = _dest>>
      <<goto "Room">>
    <</link>><br>
  <</if>>

<</for>>


<hr>

<form>
  <<textbox "$command" "command">>
</form>

<<button "Enter">>
  <<set _cmd = $command.toLowerCase()>>

  <<if _cmd is "look">>
    <<goto "Room">>

  <<elseif _cmd is "north" or _cmd is "n">>
    <<set _dir = "north">>
    <<if $world[$location].exits[_dir]>>
      <<set $location = $world[$location].exits[_dir]>>
    <</if>>
    <<goto "Room">>

  <<elseif _cmd is "south" or _cmd is "s">>
    <<set _dir = "south">>
    <<if $world[$location].exits[_dir]>>
      <<set $location = $world[$location].exits[_dir]>>
    <</if>>
    <<goto "Room">>

  <<elseif _cmd is "east" or _cmd is "e">>
    <<set _dir = "east">>
    <<if $world[$location].exits[_dir]>>
      <<set $location = $world[$location].exits[_dir]>>
    <</if>>
    <<goto "Room">>

  <<elseif _cmd is "west" or _cmd is "w">>
    <<set _dir = "west">>
    <<if $world[$location].exits[_dir]>>
      <<set $location = $world[$location].exits[_dir]>>
    <</if>>
    <<goto "Room">>

  <<else>>
    You can't do that.
  <</if>>
<</button>>

<b>Commands:</b><br>
<<link "Look">><<goto "Room">><</link>> |
<<link "Map">><<goto "Map">><</link>>
</main>
<<include "footer">>

:: Map [nobr]
<main>
    <h3>Where are we?</h3>
    
    You are currently in: <b><<= $location>></b><br><br>
    
    <<for _room, _data range $world>>
      <<if _room is $location>>
        ▶ <<=_data.name>><br>
      <<else>>
        · <<=_data.name>><br>
      <</if>>
    <</for>>
    
    <br>
    <<link "Back">><<goto "Room">><</link>>
</main>

