<</append>>
<</timed>>

<<timed 8s>>
<<append "#mount">>
<<type 60ms>>
<p>and ready for a challenge.</p>
<</type>>
<</append>>
<</timed>>

<<timed 10s>>
<<append "#mount">>
<<type 60ms>>
<p>Today is the day, you can feel it.</p>
<</type>>
<</append>>
<</timed>>

<<timed 12s>>
<<append "#mount">>
<<type 60ms>>
<p>Its time to work out what the hell this show is about.</p>
<</type>>
<</append>>
<</timed>>

<<timed 16s>>
<<append "#mount">>
<<type 60ms>>
<p>
<<button "Go">>
<<goto "Notebook">>
<</button>>
</p>
<</type>>
<</append>>
<</timed>>



