:: StoryInit {"position":"100,100","size":"100,100"}

<<set $location = "sisters">>

<<set $world = {
  sisters: {
    name: "Silver Sisterhood",
    desc: "Who were they? How can we know them better?",
        notes: ["martindale","burtonport","langridge","stbrides","matriarchy","tyndall"],
    exits: {
      east: "art",
      south: "fiction"
    }, 
     locked: false
  },

  art: {
    name: "Making Art",
    desc: "Trying to put boundaries on the undefinable and the infinite",
     notes: ["figs in wigs","eoghan","lauren","decisions","sprawling","making sense"],
     exits: {
      west: "sisters",
      south: "collaboration"
    }, 
     locked: false
  },

  fiction: {
    name: "Fictionalised verisons of ourselves",
    desc: "We don't want to commit to becoming entangled with these people. So its really about a fictionalised version of us",
     notes: ["pigs in wigs","figs and wigs","figs with wigs","wigs in figs","loghan","eouren"],
    exits: {
      north: "sisters",
    west: "power",
    east: "collaboration"
  }, 
   locked: false
  }, 
  power: {
    name: "The Corrupting Influence of Power",
    desc: "Can anything ever be truly equal? How long can idealism last?",
    notes: ["hierarchy","fear","democracy","fallacy","lies","radical"],
  exits: {
    east: "fiction",
    south: "truth"
  }, 
   locked: false
  }, 
  collaboration: {
    name: "Collaboration",
    desc: "Can you ever really know what someone else is thinking?",
    notes: ["yes","no","irrelavant"],
    exits: {
    north: "art",
    west: "fiction",
  }, 
   locked: false
  }, 
  truth: {
    name: "Truth",
    desc: "?????",
    notes: ["the truth"],
    exits: {
    north: "power",
  }, 
  locked: true
  }, 
  
}>>


